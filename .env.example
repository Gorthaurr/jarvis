# ─────────────────────────────────────────────────────────────
# Jarvis — пример переменных окружения сервера (apps/server).
# Скопировать в .env и заполнить. .env в git НЕ коммитится (.gitignore).
# ─────────────────────────────────────────────────────────────

# --- сервер ---
PORT=8787
# §6B/безопасность: ТОЛЬКО loopback по умолчанию. Реальная граница на loopback — это bind-адрес,
# а НЕ токен (на 127.0.0.1 токен это ключ партиции, любой локальный процесс его переиграет).
HOST=127.0.0.1
NODE_ENV=development
PROTOCOL_VERSION=1

# --- §6B мультитенант / auth (дефолты безопасны: ничего не меняют для одиночной установки) ---
# Клиент: сгенерировать стабильный per-install UUID и слать его как токен (ОПТ-ИН). По умолчанию
# выключено → клиент шлёт 'dev-token' → DEV_USER → существующая установка НЕ теряет данные.
# Включать вместе с релизом B3 (партиция сторов), не раньше.
JARVIS_CLIENT_IDENTITY=
# Сервер: строгая верификация токена по таблице auth_tokens (LAN/hosted). По умолчанию выкл —
# на loopback это театр. Включать только при HOST!=loopback или мульти-юзер режиме.
JARVIS_AUTH_STRICT=
# Сервер: явно разрешить не-loopback bind. Без него listen-гард принудит 127.0.0.1 (LAN-сосед не
# должен самопровижнить любой userId, пока auth дремлет). Ставить ТОЛЬКО вместе с JARVIS_AUTH_STRICT=1.
JARVIS_ALLOW_REMOTE=
# Dev/континьюити: зафиксировать userId сервера для не-UUID токена (UUID-строка). Power-юзер может
# выставить JARVIS_CLIENT_TOKEN=<свой-uuid> на клиенте, чтобы перенести раздел при апгрейде.
JARVIS_DEV_USER_ID=

# --- база ---
DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis

# --- мастер-ключ шифрования серверных кред (§13) ---
# 32 байта в hex; НЕ хранить в БД. В проде — из secret-менеджера.
CREDENTIALS_MASTER_KEY=

# --- LLM (Anthropic SDK, тиры §7) ---
ANTHROPIC_API_KEY=
# Base URL шлюза/прокси (РФ: proxyapi.ru и т.п.). Пусто = прямой Anthropic.
# Примеры: https://api.proxyapi.ru/anthropic  |  https://api.vsegpt.ru/v1
ANTHROPIC_BASE_URL=
TIER1_MODEL=claude-haiku-4-5
TIER2_MODEL=claude-sonnet-4-6
TIER3_MODEL=claude-fable-5
# TTL prompt-кеша (§15): 5m (дефолт) или 1h (extended, при частых командах)
ANTHROPIC_CACHE_TTL=5m

# --- эмбеддинги (OpenAI text-embedding-3-small, §1) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- голос ---
# STT: 'whisper' (локально, без ключей, дефолт без Deepgram) | 'deepgram' | 'mock'
STT_PROVIDER=whisper
WHISPER_MODEL=Xenova/whisper-base
# Зеркало HuggingFace для скачивания модели (huggingface.co из РФ часто недоступен)
HF_ENDPOINT=https://hf-mirror.com
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Адаптивная скорость речи: на длинной фразе чуть поджимаем темп (короткую не трогаем).
# JARVIS_TTS_SPEEDUP=0 — выключить. MAX — макс. множитель на самой длинной фразе.
# MIN_CHARS — короче этого ускорения нет; FULL_CHARS — длиннее этого полный множитель.
JARVIS_TTS_SPEEDUP=1
JARVIS_TTS_SPEEDUP_MAX=1.12
JARVIS_TTS_SPEEDUP_MIN_CHARS=90
JARVIS_TTS_SPEEDUP_FULL_CHARS=280
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- веб-знания (§12) ---
BRAVE_SEARCH_API_KEY=

# --- карты / ETA (§9, §12) ---
MAPS_PROVIDER=osrm
YANDEX_MAPS_API_KEY=
OSRM_URL=http://localhost:5000

# --- биллинг (§14) ---
DEFAULT_SPEND_CAP=300.00

# --- мобильные пуши (§12) ---
FCM_SERVICE_ACCOUNT_JSON=

# --- AX-Ref веб-механизм (2026-07-15, docs/WEB_ENV_REDESIGN_2026-07-15.md) ---
# Адресация веб-элементов по ИДЕНТИЧНОСТИ (ref-реестр) вместо хрупкого CSS-селектора + browser_batch +
# per-host рецепты + гейт Яндекс-хардкода. Деф OFF — включать после живого смоука в реальном Chrome
# (reload расширения + не-Яндекс сайт с iframe/shadow/логин-формой; регресс-гейт на Я.Музыке).
JARVIS_BROWSER_REF=0

# --- Волна «реальный Джарвис» А (2026-07-28) ---
# Алерты супервизора работают БЕЗ НАСТРОЙКИ: (1) Джарвис САМ докладывает голосом при подключении
# («ночью я падал, поднялся сам»), (2) нативный Windows-toast, (3) msg.exe, (4) infra/supervisor.log.
# Переменные ниже — ЧИСТО ОПЦИОНАЛЬНЫЕ: заполнять только если хочется дублировать алерт в Telegram,
# чтобы узнавать о сбоях ВНЕ ДОМА. Пусто = нормальный режим, ничего не сломано.
JARVIS_ALERT_TG_TOKEN=
JARVIS_ALERT_TG_CHAT=
# Порог «значимого простоя» для голосового доклада: короче — не докладываем (ручной рестарт владельца
# не должен звучать как «я падал»); дольше — Джарвис скажет «я был недоступен N мин». Мс, деф 60с.
JARVIS_INCIDENT_MIN_DOWN_MS=60000
# Период watchdog-опроса /healthz супервизором, мс (мин 10000).
JARVIS_SUP_HEALTH_MS=60000
# Автозапуск КЛИЕНТА с Windows (login item): 1 = включить, 0 = снять, пусто = не трогать.
JARVIS_AUTOSTART=
# Durable-лог клиента (%APPDATA%/Jarvis/logs/client-*.log). 0 = выключить.
JARVIS_CLIENT_FILE_LOG=1
# Кап курируемых фактов профиля (вытеснение теперь в архив evicted-*.jsonl, не бесследно). Кламп [10,500].
JARVIS_PROFILE_FACTS_MAX=50
# WARN «диск почти полон» в process_health при свободном месте ниже порога, МБ.
JARVIS_DISK_MIN_FREE_MB=2048
# TTL отложенного действия watch (сработало офлайн): старше — НЕ исполняется молча при коннекте,
# владельцу честное «поручение устарело». Мс, деф 30 мин.
JARVIS_WATCH_PENDING_ACTION_TTL_MS=1800000
# Путь к .env, если он лежит не в корне репо (supervisor читает ту же цепочку, что сервер).
JARVIS_ENV_PATH=
# Рецепт сайта, проваленный ≥ N раз, recall перестаёт подсовывать (учится на ошибках).
JARVIS_SITE_RECIPE_FAIL_SUPPRESS=3

# --- Волна B «мгновенный голос» (2026-07-29) ---
# Через сколько мс молчания раздумья звучит earcon «услышал, думаю» (0=выкл). 700: любой поход к
# модели даёт слышимый отклик раньше, чем тишина читается как «не понял»; быстрые ходы — чистые.
JARVIS_THINK_EARCON_MS=700
# Сигнал «динамик клиента занят» старше этого — считаем протухшим (очередь озвучки не запирается
# навсегда, если клиент отвалился/старой версии). Мс.
JARVIS_PLAYBACK_SIGNAL_STALE_MS=120000
# Дедлайн подтверждения воспроизведения клиентом (оптимистичная пометка «динамик занят»). Мс.
JARVIS_PLAYBACK_CONFIRM_MS=1500
# Игнорировать сигнал «динамик свободен», пришедший раньше этого срока после отправки звука
# (он описывает состояние ДО нашего чанка — иначе очередь выпустит реплику поверх играющей). Мс.
JARVIS_PLAYBACK_FALSE_GRACE_MS=400

# --- Волна D «мажордом» (2026-07-29) ---
# Суточный кап рефлекса обязательств («завтра надо позвонить маме» → напоминание само). 0 = выключить.
JARVIS_COMMITMENT_REFLECT_CAP=6
# Полностью выключить рефлекс обязательств.
JARVIS_COMMITMENT_REFLECT=1
# Окно «одно дело — одно напоминание»: похожее по сути напоминание в этом окне не дублируется. Мс.
JARVIS_REMINDER_SUBJECT_WINDOW_MS=7200000
# Брифинг дня (сводка при первом контакте суток). 0 = выключить.
JARVIS_BRIEFING=1

# ── ВОЛНА G: РЕЗЕРВ МОЗГА НА ПОДПИСКЕ (Claude Max через Agent SDK) ──
# Когда API-ключ исчерпан («credit balance is too low») / лимит / сеть — ход уходит на подписку
# вместо стаба «связь прервалась». Токен получают ОДИН раз командой:  claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat-...
# JARVIS_SUBSCRIPTION_FALLBACK=0   # выключить резерв совсем
# JARVIS_FORCE_SUBSCRIPTION=1      # ПРОВЕРКА: гнать все ходы через подписку, минуя API
# Модель и эффорт резерва (решение владельца: сильная модель + максимум — резерв это последний шанс
# сделать ход правильно, а лимиты подписки уже оплачены). Проверено живьём: доступны fable/opus.
# JARVIS_SUBSCRIPTION_MODEL=opus     # деф opus (Opus 5); варианты: fable, claude-fable-5, claude-opus-5
# JARVIS_SUBSCRIPTION_EFFORT=        # W2 (2026-09-09): деф ПО ТИРУ — haiku medium / sonnet high / fable max
#                                    # (скорость: длинное размышление на max держало p90 хода 20-31 с).
#                                    # Задать max = вернуть решение 2026-09-02 «max на каждом ходе»; low|medium|high|xhigh|max
#
# ── ОСНОВНОЙ КАНАЛ (API по ключу): как его выключает система ──
# Отказ, который повтором НЕ лечится (кончился баланс / ключ не принят), ВЫКЛЮЧАЕТ канал с первого
# раза — без «паузы и снова стучимся». Дальше все ходы идут по подписке, к API не уходит ни одного
# запроса. Пополнили баланс — подхватится само: после перепроверки или при следующем перезапуске.
# JARVIS_PRIMARY_LLM=0               # ЯВНО выключить API-канал совсем (работаем только по подписке)
# JARVIS_PRIMARY_RECHECK_MS=21600000 # когда перепроверить выключённый канал; деф 6 ч, 0 = никогда
# JARVIS_PRIMARY_COOLDOWN_MS=300000  # пауза после ТРАНЗИЕНТНЫХ сбоев (сеть/429); деф 5 мин
#
# ── РЕЖИМ РАБОТЫ ОТ ПОДПИСКИ: бюджеты шире, потому что раунд ДОРОЖЕ по времени ──
# Потолок задачи (JARVIS_TASK_MAX_MS, деф 240с) калиброван под ОСНОВНОЙ канал: там раунд с
# prompt-кешем стоит доли секунды. У резерва кеша нет вовсе — замер по логу: медиана 4.9с, p90 14.9с
# НА РАУНД, и 22-шаговая GUI-задача физически не влезает в 240с. Пока основной канал ВЫКЛЮЧЕН,
# потолок умножается на этот коэффициент (кламп [1,5]; 1 = вести себя как раньше).
# JARVIS_SUBSCRIPTION_TASK_X=2
# Померить быстроту: спроси «в чём твои слабости» — self_weaknesses печатает медиану и p90
# обращения к модели ОТДЕЛЬНО по каналам (данные копятся в data/logs/metrics.jsonl, строки type:"round").

# ── ПОЧТА: ИСХОДЯЩАЯ (mail_send, 2026-09-02). Пароль ПРИЛОЖЕНИЯ заводит владелец в настройках ящика. ──
# MAIL_SMTP_HOST=smtp.yandex.ru      # smtp.mail.ru / smtp.gmail.com
# MAIL_SMTP_PORT=465                 # 465 = implicit TLS, 587 = STARTTLS (MAIL_SMTP_TLS=implicit|starttls)
# MAIL_USER=you@yandex.ru
# MAIL_PASSWORD=app-password         # НЕ основной пароль
# MAIL_FROM=you@yandex.ru            # опц.
# MAIL_IMAP_HOST=imap.yandex.ru      # опц., деф smtp.→imap.; сверка копии в «Отправленных» по Message-ID
# MAIL_IMAP=0                        # выключить IMAP-сверку

# ── ПРОДУКТОВЫЙ КАРКАС (2026-09-02): ВСЁ ЗА МАСТЕР-ПЕРЕКЛЮЧАТЕЛЕМ. 0/отсутствует = ровно сегодняшнее поведение. ──
# Полный профиль второго инстанса «режим пользователя» — .env.product.example + infra\run-product.ps1.
# JARVIS_PRODUCT_MODE=0            # 1 = аккаунты, device-токены, планы/квоты, оплата, отчёты, выбор модели по плану
# JARVIS_ROLE=all                  # all | node | brain (только при 1)
# JARVIS_PRODUCT_AUTH=1            # подфлаги (только при 1): auth / quotas / billing (деф 1), library / telemetry (деф 0)
# JARVIS_BILLING_PROVIDER=none     # none | fake | yookassa
# JARVIS_PRODUCT_DEFAULT_PLAN=demo # план новому пользователю без подписки (демо для друзей); пусто = квота 0
# JARVIS_ADMIN_TOKEN=              # токен /v1/admin/* и отчётов; пусто = только loopback
# JARVIS_RUB_PER_USD=85            # курс для кредитов (1 кредит = 1 ₽) и маржи в отчётах
# JARVIS_EMAIL_PEPPER=             # HMAC-перец email_hash (иначе производная мастер-ключа)
# JARVIS_LLM_PROXY_URL=            # LLM-прокси проекта (ступень 1); пусто = прямой Anthropic
# Продуктовые миграции применяются ТОЛЬКО `node infra/migrate.mjs --product` (или при JARVIS_PRODUCT_MODE=1).

# ── §РЕЖИМ ВЫДЕЛЕНИЯ (2026-09-03): владелец обводит кусок экрана и говорит о нём «вот тут» ────────
# Глобальная горячая клавиша «обвести область» (Electron-формат акселератора). Пусто = не регистрировать
# вовсе (тогда только голосом: «выдели область» / «убери выделение»). Клавиша занята другой программой →
# честный WARN в логе клиента, голосовой путь продолжает работать.
# JARVIS_SELECTION_HOTKEY=Control+Alt+X
# Сколько держать вуаль рисования без действий владельца, прежде чем закрыть её самим (мс, деф 120000).
# JARVIS_SELECTION_DRAW_TIMEOUT_MS=120000
# Сколько кадров ВЫДЕЛЕННОЙ области держать в контексте отдельно от скриншотов (деф 1, кламп 1..4).
# JARVIS_KEEP_SELECTION_VIEWS=1

# --- W0 (2026-09-09): слух, стоп-рефлекс, скорость, периметр ---
# ID расширения Chrome, которому ОДНОМУ разрешён канал /ext (куки, Telegram). Пусто = любое расширение + WARN с ID в логе.
# ID стабилен (поле "key" в apps/extension/manifest.json, с 2026-09-24): переезд папки его больше не меняет.
# JARVIS_EXT_ID=pjkeladocehklaefmnhapmmpabmaeajd
# Самоосмотр по первой реплике («почини себя»): 0 = выключен.
# JARVIS_SELF_REVIEW=0
# Через сколько мс ход с инструментами говорит короткий ack и уходит в фон (деф 1500; было 10000 — mouth-to-ear 10 с).
# JARVIS_SYNC_PROMOTE_MS=1500

# --- W1 (2026-09-09): локальный слух ---
# Модели локального wake («Джарвис», sherpa-onnx KWS) и Silero VAD. Ставит `node apps/client/scripts/fetch-hearing-models.mjs`.
# Путь ОБЯЗАН быть ASCII (нативный sherpa не читает кириллицу): деф ~/.jarvis/models.
# JARVIS_HEARING_MODELS=
# Файл ключевых слов (BPE-написания «Джарвис»); деф <models>/kws/jarvis-keywords.txt.
# JARVIS_WAKE_KEYWORDS=
# 0 = не поднимать локальный слух (гейт открыт постоянно, wake по тексту облака — прежний режим).
# JARVIS_LOCAL_WAKE=1
# Гейт диктора: soft (деф) — чужой голос режется только БЕЗ обращения, «Джарвис» проходит; strict — как раньше.
# JARVIS_SPEAKER_GATE_MODE=soft

# --- W2 (2026-09-09): мозг быстрый ПО ПОДПИСКЕ (API не оплачиваем) ---
# Одна сессия SDK на задачу: между раундами CLI не пересоздаётся, история сидит в кеше CLI, результат
# инструмента уходит модели MCP-результатом (картинки — штатно). Ключ сессии = id задачи, петля
# освобождает её в finally. Отдельных флагов нет; в логе каждая строка «резерв: раунд» несёт
# mode fresh|continued, initMs, ttftMs, totalMs и настоящие cacheRead/cacheCreate.
